{
  "name": "gridiron-give",
  "version": "1.0.0",
  "private": true,
  "description": "Equipment fundraising for high school and youth athletes: donors fund specific gear for specific players, coaches buy it and account for every dollar.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
