# Gridiron Give configuration. Copy to .env.local for local development.
# With nothing set, the app runs in demo mode: an embedded database with
# sample data, simulated payments and an on-site email outbox.
# Full instructions: docs/SETUP.md

# --- App -------------------------------------------------------------------
# Public URL, no trailing slash. On Vercel it defaults to the deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs receipt and photo links and keys team code hashes. Required in live mode.
# Set it once: changing it invalidates every team code and signed link.
# Generate with: openssl rand -base64 32
APP_SECRET=
# Comma-separated emails that get platform admin on first sign-in.
ADMIN_EMAILS=
SUPPORT_EMAIL=support@gridirongive.com

# --- Supabase (setting DATABASE_URL switches demo mode off) ------------------
# Project Settings > Database > Connection string > Transaction pooler (port 6543).
DATABASE_URL=
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (both keys switch simulated payments off) -------------------------
# Use test keys (sk_test_, pk_test_) until you are ready to take real money.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secrets of the two event destinations for https://<your-domain>/api/stripe/webhook:
# one listening to "Your account", one listening to "Connected accounts".
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Live mode without Stripe keys refuses payments unless this is true (staging only).
ALLOW_SIMULATED_PAYMENTS=false

# --- Email (without a key, email goes to the outbox at /dev/outbox) ----------
RESEND_API_KEY=
EMAIL_FROM=Gridiron Give <notifications@gridirongive.com>

# --- Scheduled job ------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily.
CRON_SECRET=

# --- Fees and receipts (defaults shown) ------------------------------------------
# Platform fee: $1.00 + 1% of each gift. 100 basis points = 1%.
PLATFORM_FEE_FIXED_CENTS=100
PLATFORM_FEE_BASIS_POINTS=100
# Stripe's standard US card pricing, used to quote fees to donors.
STRIPE_FEE_FIXED_CENTS=30
STRIPE_FEE_BASIS_POINTS=290
# Receipts never say "tax deductible" unless this is true AND the team's
# organization is marked tax exempt with an EIN.
RECEIPTS_TAX_DEDUCTIBLE=false

# --- Demo and tests only --------------------------------------------------------
# Where the embedded demo database lives (default .data/pglite).
PGLITE_DIR=
